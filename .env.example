# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Postgres (used by docker-compose.yml and the server)
POSTGRES_USER=webhook
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=webhook
POSTGRES_PORT=5432
DATABASE_URL=postgres://webhook:change-me-local-only@127.0.0.1:5432/webhook?sslmode=disable

# API server
LISTEN_ADDR=127.0.0.1:8080
# Required. Clients send "Authorization: Bearer <API_KEY>". Generate one with: openssl rand -hex 32
API_KEY=change-me

# Delivery workers
WORKER_COUNT=4
MAX_ATTEMPTS=8
BACKOFF_BASE=1s
BACKOFF_MAX=10m
DELIVERY_TIMEOUT=5s
LEASE_DURATION=30s
POLL_INTERVAL=250ms
CLAIM_BATCH_SIZE=10

# Fake receiver (cmd/receiver)
RECEIVER_ADDR=127.0.0.1:9090
RECEIVER_FAIL_RATE=0.3
