# Settings template. Create your .env with generated secrets by running:
#   ./scripts/init-env.sh
# .env is git-ignored; never commit real values.

# Postgres (used by docker-compose.yml and the server).
# init-env.sh replaces REPLACE_WITH_DB_PASSWORD with a random password.
POSTGRES_USER=webhook
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=webhook
POSTGRES_PORT=5432
DATABASE_URL=postgres://webhook:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/webhook?sslmode=disable
# Connection pool size. Keep it above WORKER_COUNT plus headroom for the API.
DB_MAX_CONNS=20

# API server
LISTEN_ADDR=127.0.0.1:8080
# Required, at least 32 characters. Clients send "Authorization: Bearer <API_KEY>".
API_KEY=
# HTTPS: set both to serve TLS directly. Plain HTTP on a non-loopback
# LISTEN_ADDR is refused unless ALLOW_INSECURE_HTTP=true (only when a reverse
# proxy terminates TLS in front of the server).
TLS_CERT_FILE=
TLS_KEY_FILE=
ALLOW_INSECURE_HTTP=false

# SSRF protection: webhooks to localhost/private/reserved addresses are
# blocked. true disables that; use only for local development.
ALLOW_PRIVATE_DESTINATIONS=false

# Delivery workers
WORKER_COUNT=4
MAX_ATTEMPTS=8
BACKOFF_BASE=1s
BACKOFF_MAX=10m
DELIVERY_TIMEOUT=5s
LEASE_DURATION=30s
POLL_INTERVAL=250ms
# Rows claimed per query. >1 cuts DB round trips but lets one worker hold
# several rows while a slow receiver blocks it.
CLAIM_BATCH_SIZE=1

# Fake receiver (cmd/receiver)
RECEIVER_ADDR=127.0.0.1:9090
RECEIVER_FAIL_RATE=0.3
